# Phase B: activate ONLY after both-name Let's Encrypt certificate exists.
# This file is included in nginx http{} as a sites-enabled file.
map $http_upgrade $rakurs_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name rakurs.zakryttya.org.ua;

    ssl_certificate /etc/letsencrypt/live/rakurs.zakryttya.org.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rakurs.zakryttya.org.ua/privkey.pem;
    ssl_session_tickets off;

    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8123;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Do NOT append user-controlled incoming X-Forwarded-For.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $rakurs_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    server_name www.rakurs.zakryttya.org.ua;

    ssl_certificate /etc/letsencrypt/live/rakurs.zakryttya.org.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rakurs.zakryttya.org.ua/privkey.pem;
    ssl_session_tickets off;

    return 301 https://rakurs.zakryttya.org.ua$request_uri;
}
